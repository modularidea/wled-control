{
	"name": "wled-control",
	"version": "0.1.1",
	"description": "Obsidian plugin to control WLED LED controllers on your local network.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck"
	},
	"keywords": [
		"obsidian",
		"wled",
		"led"
	],
	"author": "modularidea",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.14.0",
		"esbuild": "^0.21.5",
		"obsidian": "^1.5.7",
		"tslib": "^2.6.3",
		"typescript": "^5.5.3"
	},
	"dependencies": {
		"bonjour-service": "^1.2.1"
	}
}
